# AWS Configuration
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=your_cognito_client_secret_here

# S3 Configuration
S3_BUCKET_NAME=your-bucket-name
S3_REGION=ap-southeast-2

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=your-table-name
DYNAMODB_REGION=ap-southeast-2

# AssemblyAI Configuration
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Service URLs (for local development)
AUTH_SERVICE_URL=http://localhost:3001
TRANSCODING_SERVICE_URL=http://localhost:3002
UPLOAD_SERVICE_URL=http://localhost:3003

# SQS Queue URLs (for background processing)
SQS_TRANSCODING_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/901444280953/transcoding-queue
SQS_UPLOAD_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/901444280953/upload-queue
SQS_STORAGE_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/901444280953/storage-queue
SQS_NOTIFICATIONS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/901444280953/notifications-queue

# Service Authentication (optional)
SERVICE_AUTH_TOKEN=your_service_auth_token

# FFmpeg Configuration
FFMPEG_PRESET=medium
FFMPEG_CRF=23
FFMPEG_FPS=30
FFMPEG_THREADS=0

# Transcoding Configuration
DEFAULT_RESOLUTIONS=["1920x1080","1280x720","854x480"]
MAX_CONCURRENT_TRANSCODES=2
MAX_FILE_SIZE=1073741824

# Monitoring Configuration
CPU_MONITORING_INTERVAL=5000

# AWS Credentials - Replace with your actual credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Load Testing Configuration - Optimized for low-resource EC2
AUTH_TOKEN=your_auth_token_here
LOAD_USERNAME=admin
LOAD_PASSWORD=admin123
LOAD_MINUTES=2
LOAD_VUS=2
LOAD_SLEEP=2

# File Upload Configuration - Optimized for low-resource EC2
MAX_FILE_SIZE=200MB
CPU_MONITORING_INTERVAL=2000
FFMPEG_THREADS=1
FFMPEG_PRESET=ultrafast
FFMPEG_CRF=28
FFMPEG_FPS=24
DEFAULT_RESOLUTIONS=["854x480"]
